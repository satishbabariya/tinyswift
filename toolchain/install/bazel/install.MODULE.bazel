"""TinySwift toolchain Bazel module.

This module exposes Bazel `cc_toolchain`s built from this TinySwift toolchain.

Add the repository to your `MODULES.bazel` and then use
`register_toolchains("@tinyswift_toolchain//:all")` to get these toolchains. For
more detailed examples, see the TinySwift project examples in examples/bazel
"""

module(name = "tinyswift_toolchain")

bazel_dep(name = "rules_cc", version = "0.1.4")
bazel_dep(name = "platforms", version = "1.0.0")

tinyswift_toolchain_config = use_extension(
    "//bazel:tinyswift_toolchain.bzl",
    "tinyswift_toolchain_config",
)
use_repo(tinyswift_toolchain_config, "tinyswift_toolchain_config")
