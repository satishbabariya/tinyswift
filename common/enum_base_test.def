#ifndef TINYSWIFT_ENUM_BASE_TEST_KIND
#error "Must define the x-macro to use this file."
#define TINYSWIFT_ENUM_BASE_TEST_KIND(Name)
#endif

TINYSWIFT_ENUM_BASE_TEST_KIND(Beep)
TINYSWIFT_ENUM_BASE_TEST_KIND(Boop)
TINYSWIFT_ENUM_BASE_TEST_KIND(Burr)

#undef TINYSWIFT_ENUM_BASE_TEST_KIND
